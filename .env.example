FLOWCAST_VERSION=0.1.0-rc.7
FLOWCAST_HTTP_PORT=8080
FLOWCAST_STREAM_PORT=8010
FLOWCAST_AUTH_ENABLED=true
FLOWCAST_DOCKER_CONTROL_ENABLED=true
FLOWCAST_DOCKER_SOCKET=/var/run/docker.sock
# The installer detects the socket group automatically; do not guess it.
# Optional absolute reverse-proxy URL. Empty means same-origin relative URLs.
FLOWCAST_PUBLIC_URL=

ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_ADMIN_PASSWORD=change-me-admin
