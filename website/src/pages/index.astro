---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CallToAction from '../components/CallToAction.astro';
import { withBase } from '../lib/paths';
import {
  flowcastVersion,
  installCommand,
} from '../lib/version';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FlowCast',
  description:
    'Self-hosted radio automation, scheduling and playout platform.',
  url: 'https://chourmovs.github.io/FlowCast-Community/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Linux amd64',
  softwareVersion: flowcastVersion,
  softwareRequirements:
    'Docker Engine and Docker Compose v2',
  codeRepository:
    'https://github.com/chourmovs/FlowCast-Community',
  downloadUrl:
    'https://github.com/chourmovs/FlowCast-Community/releases',
  license:
    'https://github.com/chourmovs/FlowCast-Community/blob/main/LICENSE',
};
---

<BaseLayout
  title="FlowCast — Self-hosted radio automation and playout"
  description="Run radio scheduling, audio analysis and automated Icecast playout on an operator-managed Linux host with FlowCast."
  structuredData={structuredData}
>
  <Hero />

  <section
    class="quick-install container"
    aria-labelledby="install-title"
  >
    <div>
      <p class="eyebrow">
        CURRENT VALIDATED RELEASE · {flowcastVersion}
      </p>

      <h2 id="install-title">
        Install FlowCast in one command
      </h2>

      <p>
        For <strong>Linux amd64</strong> with Docker Engine
        and Docker Compose v2 already available.
      </p>
    </div>

    <div class="terminal">
      <div class="terminal-bar">
        <span></span>
        <span></span>
        <span></span>
        <b>flowcast-install</b>
      </div>

      <pre><code>{installCommand}</code></pre>

      <a href={withBase('installation')}>
        Open the complete installation guide →
      </a>
    </div>
  </section>

  <section
    class="product-features container"
    aria-labelledby="features-title"
  >
    <div class="section-heading">
      <p class="eyebrow">
        BUILT FOR THE BROADCAST PATH
      </p>

      <h2 id="features-title">
        The station workflow, connected.
      </h2>

      <p>
        FlowCast keeps programming decisions and runtime
        execution in one observable system.
      </p>
    </div>

    <article class="feature-row">
      <span class="feature-number">01</span>

      <div>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M8 29h6l4-13 7 24 6-31 5 20h5" />
        </svg>

        <h3>Purpose-built Rust playout</h3>
      </div>

      <div>
        <p>
          A dedicated engine executes queues, fades, encoding
          and Icecast output from explicit station
          configuration.
        </p>

        <code>
          Scheduler → queue → encoder → Icecast
        </code>

        <a href={withBase('liquidsoap-alternative')}>
          Why a dedicated engine →
        </a>
      </div>
    </article>

    <article class="feature-row">
      <span class="feature-number">02</span>

      <div>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle cx="15" cy="24" r="7" />
          <circle cx="34" cy="16" r="5" />
          <path d="M21 22l8-4M14 31v7m20-17v17" />
        </svg>

        <h3>Music-aware scheduling</h3>
      </div>

      <div>
        <p>
          Editorial playlist rules stay in control while
          tempo analysis can inform track selection and
          pacing.
        </p>

        <code>Rules + BPM-aware selection</code>

        <a href={withBase('features')}>
          Explore scheduling features →
        </a>
      </div>
    </article>

    <article class="feature-row">
      <span class="feature-number">03</span>

      <div>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path
            d="M7 32c7 0 8-16 16-16s9 16 18 16M7 16c7 0 8 16 16 16s9-16 18-16"
          />
        </svg>

        <h3>Transitions as programming tools</h3>
      </div>

      <div>
        <p>
          Shape the sound with fade-in, fade-out, overlap,
          bridges, track exits, prefetch and queue controls.
        </p>

        <code>Fade · overlap · bridge · exit</code>

        <a href={withBase('features')}>
          See the full control surface →
        </a>
      </div>
    </article>
  </section>

  <section class="interface-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">
          A REAL OPERATOR INTERFACE
        </p>

        <h2>
          Control the station. See what happens next.
        </h2>

        <p>
          Runtime state, media, schedules and transitions are
          visible from the authenticated FlowCast control
          plane.
        </p>
      </div>

      <nav
        class="static-tabs"
        aria-label="Interface views"
      >
        <a href="#station-control">Station control</a>
        <a href="#media">Media and playlists</a>
        <a href="#scheduling">
          Scheduling and transitions
        </a>
      </nav>

      <div
        id="station-control"
        class="product-window showcase"
      >
        <div class="window-bar">
          <i></i>
          <i></i>
          <i></i>
          <span>Station control · Live overview</span>
        </div>

        <img
          src={withBase('screenshots/Capture1.png')}
          width="1900"
          height="1079"
          alt="FlowCast dashboard with live station status, Now Playing and upcoming tracks"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="interface-secondary">
        <figure id="media">
          <img
            src={withBase('screenshots/Capture3.png')}
            width="1904"
            height="912"
            alt="FlowCast media catalogue with analysis and playlist controls"
            loading="lazy"
            decoding="async"
          />

          <figcaption>
            <strong>Media and playlists</strong>
            <span>
              Catalogue, search, upload and analysis status.
            </span>
          </figcaption>
        </figure>

        <figure id="scheduling">
          <img
            src={withBase('screenshots/Capture7.png')}
            width="1907"
            height="912"
            alt="FlowCast transition settings for fades, silence and bridge overlap"
            loading="lazy"
            decoding="async"
          />

          <figcaption>
            <strong>Scheduling and transitions</strong>
            <span>
              Explicit controls for the sound between tracks.
            </span>
          </figcaption>
        </figure>
      </div>

      <a
        class="section-link"
        href={withBase('screenshots')}
      >
        Explore the complete interface gallery →
      </a>
    </div>
  </section>

  <section class="architecture container">
    <div class="architecture-copy">
      <p class="eyebrow">
        ONE EXPLICIT BROADCAST PATH
      </p>

      <h2>From operator intent to listeners.</h2>

      <p>
        The control plane configures a focused runtime instead
        of generating a Liquidsoap program for another
        scripting layer.
      </p>

      <a href={withBase('liquidsoap-alternative')}>
        Understand the architectural trade-offs →
      </a>
    </div>

    <div
      class="flow-diagram"
      role="img"
      aria-label="Control flows to Scheduler, Rust playout, Icecast and Listeners, with Analyzer, BPM and Bliss supporting scheduling"
    >
      <div class="flow-main">
        <span>Control</span>
        <b>→</b>
        <span>Scheduler</span>
        <b>→</b>
        <span class="accent">Rust playout</span>
        <b>→</b>
        <span>Icecast</span>
        <b>→</b>
        <span>Listeners</span>
      </div>

      <div class="flow-support">
        <i>↳</i>
        <span>Analyzer</span>
        <span>BPM</span>
        <span>
          Bliss
          <small>optional Pro</small>
        </span>
      </div>
    </div>
  </section>

  <section class="editions container">
    <div class="section-heading">
      <p class="eyebrow">
        OPEN CORE, CLEAR BOUNDARIES
      </p>

      <h2>
        Community is an autonomous broadcast system.
      </h2>
    </div>

    <div class="edition-grid">
      <article class="edition community">
        <span class="edition-label">
          Community · {flowcastVersion}
        </span>

        <h3>Own the complete path</h3>

        <p>
          No mandatory remote licence request. Run station
          control, scheduling, BPM-aware selection, Rust
          playout and Icecast locally.
        </p>

        <ul>
          <li>Autonomous broadcast path</li>
          <li>Diagnostics, backup and restore</li>
          <li>Controlled update and rollback</li>
        </ul>

        <a
          class="button"
          href={withBase('installation')}
        >
          Install Community
        </a>
      </article>

      <article class="edition">
        <span class="edition-label">
          Optional · Separately licensed
        </span>

        <h3>FlowCast Pro</h3>

        <p>
          Add documented programming capabilities without
          changing the Community edition’s ability to
          broadcast.
        </p>

        <ul>
          <li>Bliss acoustic similarity</li>
          <li>
            Advanced documented programming strategies
          </li>
        </ul>

        <a href={withBase('community-vs-pro')}>
          Compare Community and Pro →
        </a>
      </article>
    </div>
  </section>

  <section class="operations container">
    <div>
      <p class="eyebrow">OPERATE WITH CONTEXT</p>

      <h2>
        Security and recovery are part of the system.
      </h2>

      <p>
        Credentials remain local. FlowCast includes
        diagnosis, backup, restore, controlled updates and
        rollback tooling.
      </p>
    </div>

    <ul>
      <li>
        <strong>Local credentials</strong>
        <span>Authentication stays on your host.</span>
      </li>

      <li>
        <strong>Backup and restore</strong>
        <span>
          Repository tooling supports recovery.
        </span>
      </li>

      <li>
        <strong>Optional Docker Control</strong>
        <span>
          Socket access is powerful and can be disabled.
        </span>
      </li>
    </ul>

    <a href={withBase('installation')}>
      Read the complete Docker socket safety note →
    </a>
  </section>

  <CallToAction />
</BaseLayout>
